# =============================================================================
# Mizan — Environment Configuration
# =============================================================================
# Lovable Cloud auto-provisions all keys below when you enable Cloud in the
# Lovable editor. This file documents what your deployment target expects.
# For Vercel / Netlify: paste these variables into the platform's env settings.
# =============================================================================

# --- Lovable Cloud (Supabase) — auto-managed by Lovable ---
# Client (browser-safe, injected by Vite):
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-ID

# Server (SSR / server functions):
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=YOUR-PROJECT-ID
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser — server-only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Lovable AI Gateway (Mizan Intelligence chatbot) ---
# Auto-provisioned. Includes Google Gemini + OpenAI models with no separate key.
LOVABLE_API_KEY=lvbl_xxxxxxxxxxxxxxxxxxxx
